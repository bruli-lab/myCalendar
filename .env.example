# Google OAuth client (Google Cloud Console). Its authorized redirect URIs must include CALLBACK_URL.
CLIENT_ID=
CLIENT_SECRET=

CALLBACK_HOST=127.0.0.1:8081
CALLBACK_URL=http://localhost:8081/callback
SERVER_HOST=127.0.0.1:8080
TOKENS_FILE=./tokens.json
LOG_LEVEL=debug

# Local ntfy from docker-compose. Open http://localhost:8086/mycalendar to see the notifications.
NTFY_URL=http://localhost:8086
NTFY_TOPIC=mycalendar
NTFY_USER=local
NTFY_PASSWORD=local

CALENDAR_ID=primary
TIMEZONE=Europe/Madrid
# Send both summaries every minute to try it out; production uses the cron defaults.
DAILY_SCHEDULE=@every 1m
WEEKLY_SCHEDULE=@every 1m
JOB_TIMEOUT=2m

# Local Grafana LGTM from docker-compose (http://localhost:3002).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
